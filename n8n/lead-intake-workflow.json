    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst required = ['eventId', 'email', 'phone', 'firstName', 'lastName', 'state'];\nconst missing = required.filter(function(f) { return !b[f]; });\nif (missing.length) {\n  throw new Error('Missing fields from webhook payload: ' + missing.join(', '));\n}\nconst digitsOnly = String(b.phone).replace(/\\D/g, '');\nconst safeUtm = b.utm || {};\nconst eventId = b.eventId;\nconst email = String(b.email).trim().toLowerCase();\nconst searchFormula = \"OR({Event ID} = '\" + eventId + \"', {Email} = '\" + email + \"')\";\nreturn [{\n  json: {\n    eventId: eventId,\n    firstName: b.firstName,\n    lastName: b.lastName,\n    email: email,\n    phone: digitsOnly,\n    state: b.state,\n    qualified: Boolean(b.qualified),\n    restrictedState: Boolean(b.restrictedState),\n    capiSent: Boolean(b.capiOk),\n    utmSource: safeUtm.utm_source || '',\n    utmMedium: safeUtm.utm_medium || '',\n    utmCampaign: safeUtm.utm_campaign || '',\n    landingUrl: b.landingUrl || '',\n    submittedAt: b.submittedAt || new Date().toISOString(),\n    rawPayload: JSON.stringify(b),\n    searchFormula: searchFormula,\n  },\n}];"
      },
