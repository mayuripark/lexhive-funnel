{
  "name": "LexHive – Lead Intake",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook: Lead Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-400, 0],
      "parameters": {
        "path": "lead-intake",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "check-secret",
      "name": "Check Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-160, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-lexhive-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      }
    },
    {
      "id": "reject-unauthorized",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [80, 140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"unauthorized\" } }}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "validate-normalize",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, -140],
      "notes": "Fails loudly (throws) on bad input instead of silently passing along a half-formed record — the error then routes to the Error Trigger workflow.",
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nconst required = ['eventId', 'email', 'phone', 'firstName', 'lastName', 'state'];\nconst missing = required.filter((f) => !b[f]);\nif (missing.length) {\n  throw new Error(`Missing fields from webhook payload: ${missing.join(', ')}`);\n}\n\nconst digitsOnly = String(b.phone).replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    eventId: b.eventId,\n    firstName: b.firstName,\n    lastName: b.lastName,\n    email: String(b.email).trim().toLowerCase(),\n    phone: digitsOnly,\n    state: b.state,\n    qualified: Boolean(b.qualified),\n    restrictedState: Boolean(b.restrictedState),\n    capiSent: Boolean(b.capiOk),\n    utmSource: b.utm?.utm_source || '',\n    utmMedium: b.utm?.utm_medium || '',\n    utmCampaign: b.utm?.utm_campaign || '',\n    landingUrl: b.landingUrl || '',\n    submittedAt: b.submittedAt || new Date().toISOString(),\n    rawPayload: JSON.stringify(b),\n  },\n}];"
      }
    },
    {
      "id": "search-existing",
      "name": "Search Existing Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [320, -140],
      "parameters": {
        "operation": "search",
        "base": { "value": "={{ $env.AIRTABLE_BASE_ID }}" },
        "table": { "value": "Leads" },
        "filterByFormula": "={{ \"OR({Event ID} = '\" + $json.eventId + \"', {Email} = '\" + $json.email + \"')\" }}",
        "options": { "limit": 1 }
      }
    },
    {
      "id": "existing-found",
      "name": "Existing Record?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [560, -140],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ]
        }
      }
    },
    {
      "id": "update-lead",
      "name": "Update Lead (dedup)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [800, -260],
      "notes": "Same eventId/email seen again — increments Touch Count instead of creating a duplicate row. This is the dedup guarantee at the database layer, matching the eventId-based dedup already happening on the Meta side.",
      "parameters": {
        "operation": "update",
        "base": { "value": "={{ $env.AIRTABLE_BASE_ID }}" },
        "table": { "value": "Leads" },
        "id": "={{ $json.id }}",
        "columns": {
          "value": {
            "Touch Count": "={{ ($json['Touch Count'] || 1) + 1 }}",
            "Meta CAPI Sent": "={{ $('Validate & Normalize').item.json.capiSent }}"
          }
        }
      }
    },
    {
      "id": "create-lead",
      "name": "Create Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [800, -40],
      "parameters": {
        "operation": "create",
        "base": { "value": "={{ $env.AIRTABLE_BASE_ID }}" },
        "table": { "value": "Leads" },
        "columns": {
          "value": {
            "Event ID": "={{ $json.eventId }}",
            "First Name": "={{ $json.firstName }}",
            "Last Name": "={{ $json.lastName }}",
            "Email": "={{ $json.email }}",
            "Phone": "={{ $json.phone }}",
            "State": "={{ $json.state }}",
            "Qualified": "={{ $json.qualified }}",
            "Restricted State": "={{ $json.restrictedState }}",
            "Review Status": "={{ $json.restrictedState ? 'Needs Manual Review' : 'Auto-Routed' }}",
            "Meta CAPI Sent": "={{ $json.capiSent }}",
            "UTM Source": "={{ $json.utmSource }}",
            "UTM Medium": "={{ $json.utmMedium }}",
            "UTM Campaign": "={{ $json.utmCampaign }}",
            "Landing URL": "={{ $json.landingUrl }}",
            "Submitted At": "={{ $json.submittedAt }}",
            "Touch Count": 1,
            "Raw Payload": "={{ $json.rawPayload }}"
          }
        }
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1040, -140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true } }}",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Webhook: Lead Intake": {
      "main": [[{ "node": "Check Webhook Secret", "type": "main", "index": 0 }]]
    },
    "Check Webhook Secret": {
      "main": [
        [{ "node": "Validate & Normalize", "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Validate & Normalize": {
      "main": [[{ "node": "Search Existing Lead", "type": "main", "index": 0 }]]
    },
    "Search Existing Lead": {
      "main": [[{ "node": "Existing Record?", "type": "main", "index": 0 }]]
    },
    "Existing Record?": {
      "main": [
        [{ "node": "Update Lead (dedup)", "type": "main", "index": 0 }],
        [{ "node": "Create Lead", "type": "main", "index": 0 }]
      ]
    },
    "Update Lead (dedup)": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    },
    "Create Lead": {
      "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LexHive – Automation Error Handler",
    "saveManualExecutions": true
  },
  "active": false
}
