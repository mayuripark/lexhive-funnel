# --- Client-side (exposed to the browser via Vite, must be prefixed VITE_) ---
VITE_META_PIXEL_ID=

# --- Server-side only (Vercel serverless functions, api/) ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=        # optional — set while testing in Meta Events Manager, remove for prod
META_CAPI_ENDPOINT_OVERRIDE= # optional — e.g. a webhook.site URL, for testing the integration without live Meta access (see README)

N8N_LEAD_WEBHOOK_URL=         # e.g. https://your-instance.n8n.cloud/webhook/lead-intake
N8N_WEBHOOK_SECRET=           # shared secret, checked by the n8n workflow's IF node
